{
  "name": "thinkpasser-remote-computer-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thinkpasser 独享远程电脑平台：客户端、网页端、管理端、供应商端与后端",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vue-tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json",
    "test:ui": "vitest run --config web/vitest.config.ts",
    "verify:design": "python backend/contracts/validate_design.py",
    "test": "node --test backend/domain/lease-policy.test.cjs backend/device-health/health-contract.test.cjs backend/device-health/reference-runtime.test.cjs web/remote-desktop/test/authority.test.mjs web/remote-desktop/test/protocol.test.mjs",
    "test:backend": "node --test backend/domain/lease-policy.test.cjs backend/device-health/health-contract.test.cjs backend/device-health/reference-runtime.test.cjs",
    "test:web": "node --test web/remote-desktop/test/authority.test.mjs web/remote-desktop/test/protocol.test.mjs",
    "test:product-domain": "node --test backend/domain/lease-policy.test.cjs",
    "demo:web-remote": "node web/remote-desktop/fixture-server.mjs",
    "demo:device-health": "node backend/device-health/reference-demo.cjs"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.1.8"
  }
}
