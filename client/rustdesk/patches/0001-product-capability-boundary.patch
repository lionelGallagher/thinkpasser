+    option_message::BoolOption, LoginRequest, Message, OptionMessage,
+};
+
+const ALLOWED_PERMISSION_OPTIONS: &[&str] = &[
+    "enable-keyboard",
+    "enable-clipboard",
+    "enable-file-transfer",
+    "enable-audio",
+    "enable-remote-restart",
+];
+
+pub fn allows_permission(option: &str) -> bool {
+    ALLOWED_PERMISSION_OPTIONS.contains(&option)
+}
+
+pub fn allows_permission_change(name: &str) -> bool {
+    matches!(name, "keyboard" | "clipboard" | "audio" | "file" | "restart")
+}
+
+pub fn allows_chat() -> bool {
+    false
+}
+
+pub fn allows_voice_call() -> bool {
+    false
+}
+
+pub fn allows_recording() -> bool {
+    false
+}
+
+pub fn allows_switch_sides() -> bool {
+    false
+}
+
+pub fn allows_printer() -> bool {
+    false
+}
+
+pub fn allows_privacy_mode() -> bool {
+    false
+}
+
+// All public connection launchers stay closed until the platform supplies a
+// device-bound grant flow. Service, installation and tray commands remain usable.
+pub fn blocks_cli_argument(argument: &str) -> bool {
+    matches!(argument.split('=').next().unwrap_or(argument),
+        "--connect" | "--play" | "--file-transfer" | "--view-camera"
+        | "--port-forward" | "--terminal" | "--terminal-admin" | "--rdp"
+        | "--terminal-helper" | "--whiteboard" | "--install-remote-printer"
+        | "--config" | "--import-config" | "--option" | "--assign" | "--deploy")
+}
+
+pub fn accepts_options(option: &OptionMessage) -> bool {
+    // Include the old OptionMessage path, not only TogglePrivacyMode.
+    // Explicit No remains accepted for compatible cleanup; unknown enum values
+    // cannot enable an excluded feature.
+    matches!(option.privacy_mode.enum_value(), Ok(BoolOption::NotSet) | Ok(BoolOption::No))
+        && matches!(option.block_input.enum_value(), Ok(BoolOption::NotSet) | Ok(BoolOption::No))
+        && matches!(option.terminal_persistent.enum_value(), Ok(BoolOption::NotSet) | Ok(BoolOption::No))
+}
+
+pub fn accepts_login(login: &LoginRequest) -> bool {
+    matches!(login.union.as_ref(), None | Some(login_request::Union::FileTransfer(_)))
+        && login.option.as_ref().map(accepts_options).unwrap_or(true)
+}
+
+pub fn accepts_controller_message(msg: &Message) -> bool {
+    match msg.union.as_ref() {
+        Some(message::Union::VoiceCallRequest(value)) => !value.is_connect,
+        Some(message::Union::VoiceCallResponse(value)) => !value.accepted,
+        Some(message::Union::AudioFrame(_))
+        | Some(message::Union::TerminalAction(_))
+        | Some(message::Union::PortForwardChannel(_)) => false,
+        Some(message::Union::Misc(value)) => match value.union.as_ref() {
+            Some(misc::Union::Option(option)) => accepts_options(option),
+            Some(misc::Union::ChatMessage(_))
+            | Some(misc::Union::AudioFormat(_))
+            | Some(misc::Union::SwitchSidesRequest(_))
+            | Some(misc::Union::SwitchBack(_)) => false,
+            Some(misc::Union::TogglePrivacyMode(value)) => !value.on,
+            Some(misc::Union::ClientRecordStatus(recording)) => !*recording,
+            Some(misc::Union::StopService(stop)) => !*stop,
+            _ => true,
+        },
+        Some(message::Union::FileAction(action)) => match action.union.as_ref() {
+            Some(file_action::Union::Send(request)) => {
+                matches!(request.file_type.enum_value(),
+                    Ok(file_transfer_send_request::FileType::Generic))
+            }
+            _ => true,
+        },
+        _ => true,
+    }
+}
+
+// The reverse direction has different legitimate messages: AudioFrame and
+// AudioFormat carry the retained remote system output and must remain allowed.
+pub fn accepts_host_message(msg: &Message) -> bool {
+    match msg.union.as_ref() {
+        Some(message::Union::VoiceCallRequest(value)) => !value.is_connect,
+        Some(message::Union::VoiceCallResponse(value)) => !value.accepted,
+        Some(message::Union::TerminalResponse(_))
+        | Some(message::Union::PortForwardChannel(_)) => false,
+        Some(message::Union::FileAction(action)) => match action.union.as_ref() {
+            Some(file_action::Union::Send(request)) => matches!(request.file_type.enum_value(),
+                Ok(file_transfer_send_request::FileType::Generic)),
+            _ => true,
+        },
+        Some(message::Union::Misc(value)) => !matches!(value.union.as_ref(),
+            Some(misc::Union::ChatMessage(_)) | Some(misc::Union::SwitchBack(_))),
+        _ => true,
+    }
+}
+
+const _: () = {
+    assert!(!env!("THINKPASSER_RENDEZVOUS_SERVER").is_empty(), "Empty product deployment input: THINKPASSER_RENDEZVOUS_SERVER");
+    assert!(!env!("THINKPASSER_RELAY_SERVER").is_empty(), "Empty product deployment input: THINKPASSER_RELAY_SERVER");
+    assert!(!env!("THINKPASSER_SERVER_KEY").is_empty(), "Empty product deployment input: THINKPASSER_SERVER_KEY");
+};
+
+pub fn initialize_profile() -> bool {
+    use hbb_common::config;
+    {
+        let mut settings = config::OVERWRITE_SETTINGS.write().unwrap();
+        settings.insert("access-mode".to_owned(), "custom".to_owned());
+        settings.insert("enable-keyboard".to_owned(), "Y".to_owned());
+        settings.insert("enable-clipboard".to_owned(), "Y".to_owned());
+        settings.insert("enable-file-transfer".to_owned(), "Y".to_owned());
+        settings.insert("enable-audio".to_owned(), "Y".to_owned());
+        settings.insert("enable-remote-restart".to_owned(), "Y".to_owned());
+        settings.insert("enable-camera".to_owned(), "N".to_owned());
+        settings.insert("enable-terminal".to_owned(), "N".to_owned());
+        settings.insert("enable-remote-printer".to_owned(), "N".to_owned());
+        settings.insert("enable-tunnel".to_owned(), "N".to_owned());
+        settings.insert("enable-record-session".to_owned(), "N".to_owned());
+        settings.insert("enable-block-input".to_owned(), "N".to_owned());
+        settings.insert("enable-privacy-mode".to_owned(), "N".to_owned());
+        settings.insert("allow-remote-config-modification".to_owned(), "N".to_owned());
+        settings.insert("allow-auto-record-incoming".to_owned(), "N".to_owned());
+        settings.insert("enable-lan-discovery".to_owned(), "N".to_owned());
+        settings.insert("direct-server".to_owned(), "N".to_owned());
+        settings.insert("allow-auto-disconnect".to_owned(), "N".to_owned());
+        settings.insert("allow-insecure-tls-fallback".to_owned(), "N".to_owned());
+        settings.insert("allow-auto-update".to_owned(), "N".to_owned());
+        settings.insert("custom-rendezvous-server".to_owned(), env!("THINKPASSER_RENDEZVOUS_SERVER").to_owned());
+        settings.insert("relay-server".to_owned(), env!("THINKPASSER_RELAY_SERVER").to_owned());
+        settings.insert("key".to_owned(), env!("THINKPASSER_SERVER_KEY").to_owned());
+    }
+    {
+        let mut settings = config::OVERWRITE_LOCAL_SETTINGS.write().unwrap();
+        settings.insert("allow-auto-record-outgoing".to_owned(), "N".to_owned());
+        settings.insert("hide-recording-button".to_owned(), "Y".to_owned());
+        settings.insert("disable-discovery-panel".to_owned(), "Y".to_owned());
+        settings.insert("disable-group-panel".to_owned(), "Y".to_owned());
+        settings.insert("printer-incomming-job-action".to_owned(), "dismiss".to_owned());
+        settings.insert("allow-printer-auto-print".to_owned(), "N".to_owned());
+        settings.insert("enable-check-update".to_owned(), "N".to_owned());
+    }
+    {
+        let mut settings = config::OVERWRITE_DISPLAY_SETTINGS.write().unwrap();
+        settings.insert("privacy_mode".to_owned(), "N".to_owned());
+        settings.insert("terminal-persistent".to_owned(), "N".to_owned());
+    }
+    {
+        let mut settings = config::BUILTIN_SETTINGS.write().unwrap();
+        settings.insert("hide-network-settings".to_owned(), "Y".to_owned());
+        settings.insert("hide-server-settings".to_owned(), "Y".to_owned());
+        settings.insert("hide-proxy-settings".to_owned(), "Y".to_owned());
+        settings.insert("hide-websocket-settings".to_owned(), "Y".to_owned());
+        settings.insert("hide-remote-printer-settings".to_owned(), "Y".to_owned());
+        settings.insert("hide-stop-service".to_owned(), "Y".to_owned());
+        settings.insert("hide-elevate-button-in-accept-window".to_owned(), "N".to_owned());
+    }
+    true
+}
+
+pub fn return_scheme() -> &'static str { "thinkpasser-return" }
+
+pub fn build_profile_json() -> String {
+    serde_json::json!({
+        "product": "thinkpasser",
+        "policySha256": "36f2fb73f9ef7614ef28daebc175123ba8f43698b3957389f510cd342dd84064",
+        "businessConnectionGrantEnforced": false,
+        "publicConnectionLaunches": false,
+        "camera": false, "microphone": false, "printer": false,
+        "recording": false, "terminalProtocol": false, "tcpTunnel": false
+    }).to_string()
+}
+
+#[cfg(test)]
+mod product_tests {
+    use super::*;
+    use base::message_proto::{AudioFrame, AudioFormat, Misc, VoiceCallRequest,
+        VoiceCallResponse, FileAction, FileTransferSendRequest, TogglePrivacyMode};
+
+    #[test]
+    fn system_audio_is_directional_and_close_messages_remain_usable() {
+        let mut message = Message::new();
+        message.set_audio_frame(AudioFrame::new());
+        assert!(accepts_host_message(&message));
+        assert!(!accepts_controller_message(&message));
+        let mut misc = Misc::new();
+        misc.set_audio_format(AudioFormat::new());
+        message.set_misc(misc);
+        assert!(accepts_host_message(&message));
+        assert!(!accepts_controller_message(&message));
+
+        for start in [false, true] {
+            message.set_voice_call_request(VoiceCallRequest { is_connect: start, ..Default::default() });
+            assert_eq!(accepts_controller_message(&message), !start);
+            assert_eq!(accepts_host_message(&message), !start);
+            message.set_voice_call_response(VoiceCallResponse { accepted: start, ..Default::default() });
+            assert_eq!(accepts_controller_message(&message), !start);
+            assert_eq!(accepts_host_message(&message), !start);
+        }
+        let mut misc = Misc::new();
+        misc.set_close_reason("normal disconnect".to_owned());
+        message.set_misc(misc);
+        assert!(accepts_controller_message(&message));
+        assert!(accepts_host_message(&message));
+    }
+
+    #[test]
+    fn printer_job_is_rejected_in_both_directions_but_generic_transfer_remains() {
+        for printer in [false, true] {
+            let mut action = FileAction::new();
+            action.set_send(FileTransferSendRequest {
+                file_type: (if printer { file_transfer_send_request::FileType::Printer }
+                            else { file_transfer_send_request::FileType::Generic }).into(),
+                ..Default::default()
+            });
+            let mut message = Message::new();
+            message.set_file_action(action);
+            assert_eq!(accepts_controller_message(&message), !printer);
+            assert_eq!(accepts_host_message(&message), !printer);
+        }
+    }
+
+    #[test]
+    fn optional_feature_cleanup_does_not_close_a_normal_desktop_session() {
+        for active in [false, true] {
+            let mut misc = Misc::new();
+            misc.set_client_record_status(active);
+            let mut message = Message::new();
+            message.set_misc(misc);
+            assert_eq!(accepts_controller_message(&message), !active);
+            let mut misc = Misc::new();
+            misc.set_toggle_privacy_mode(TogglePrivacyMode { on: active, ..Default::default() });
+            message.set_misc(misc);
+            assert_eq!(accepts_controller_message(&message), !active);
+        }
+    }
+}
