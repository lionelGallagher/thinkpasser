        "accepted": [
          "stopping",
          "reconciling",
          "completed"
        ],
        "stopping": [
          "reconciling",
          "exception"
        ],
        "reconciling": [
          "refund_pending",
          "completed",
          "exception"
        ],
        "refund_pending": [
          "completed",
          "exception"
        ],
        "exception": [
          "reconciling",
          "refund_pending",
          "completed"
        ],
        "completed": []
      }
