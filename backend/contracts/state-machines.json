  "note": "设计模型，不是已接入真实设备的工作流引擎；所有无列出的转换拒绝。",
  "machines": {
    "unit": {
      "initial": "preparing",
      "terminal": [
        "delivered",
        "cancelled"
      ],
      "transitions": {
        "preparing": [
          "ready",
          "exception",
          "cancelled"
        ],
        "exception": [
          "preparing",
          "cancelled"
        ],
        "ready": [
          "delivered",
          "exception",
          "cancelled"
        ],
        "delivered": [],
        "cancelled": []
      }
    },
    "credential": {
      "initial": "pending",
      "terminal": [
        "retired"
      ],
      "transitions": {
        "pending": [
          "active",
          "unknown",
          "retired"
        ],
        "active": [
          "retired",
          "unknown"
        ],
        "unknown": [
          "active",
          "retired"
        ],
        "retired": []
      }
    },
    "session": {
