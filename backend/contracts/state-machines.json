          "active",
          "closing",
          "failed"
        ],
        "active": [
          "closing"
        ],
        "closing": [
          "closed"
        ],
        "closed": [],
        "failed": []
      },
      "invariants": [
        "revokedAt is independent from physical transport state",
        "closing retains exclusive control slot until verified CloseAck or verified external isolation",
        "failed is permitted only after proving no open transport"
      ]
    },
    "operation": {
      "initial": "queued",
