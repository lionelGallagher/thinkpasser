      "invariants": [
        "only verified inspection can produce available",
        "unknown destructive operations remain quarantined or clearing",
        "supplier external isolation and reset capabilities are verified before sale"
      ]
    },
    "aiEntitlement": {
      "initial": "preparing",
      "terminal": [
        "expired",
        "terminated"
