          "accepted",
          "rejected",
          "unknown"
        ],
        "accepted": [
          "effect_reported",
          "failed",
          "unknown",
          "not_configured"
        ],
        "effect_reported": [
          "verified",
          "unknown",
          "failed"
        ],
        "unknown": [
          "effect_reported",
          "failed",
          "not_configured"
        ],
        "verified": [],
        "failed": [],
        "not_configured": [],
        "rejected": [],
        "expired": []
