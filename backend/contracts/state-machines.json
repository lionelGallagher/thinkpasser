          "available",
          "expired",
          "terminated"
        ],
        "expired": [],
        "terminated": []
      },
      "invariants": [
        "available still requires now within original promise interval",
        "no platform entitlement exists without its lease",
        "AI expiry does not revoke an active computer"
      ]
    },
    "settlement": {
      "initial": "draft",
      "terminal": [
        "paid",
        "failed"
      ],
